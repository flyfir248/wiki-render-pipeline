# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=        # https://console.anthropic.com -- research, scripts, topic ideas
PEXELS_API_KEY=           # https://www.pexels.com/api/ -- free stock footage/photos (optional)
UNSPLASH_ACCESS_KEY=      # https://unsplash.com/developers -- free stock photos, tried before Pexels (optional)
ELEVENLABS_API_KEY=       # https://elevenlabs.io -- only if voice.provider = elevenlabs
GROQ_API_KEY=             # https://console.groq.com/keys -- free; scripts via open models when llm.provider = openai
INSTAGRAM_TOKEN=          # `python -m fyt ig-token` -- only to post Shorts as Instagram Reels
INSTAGRAM_USER_ID=        # the Instagram account's id (printed by `fyt ig-token`)
THREADS_TOKEN=            # only to post Shorts to Threads: a token from the app's Threads use case
THREADS_APP_SECRET=       # the Threads app secret, so THREADS_TOKEN is renewed before it expires
